# Copy to .env.local (local) or set in Vercel (production).

# Supabase — local values come from `npx supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Public URL of this app (QR codes, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Must equal private.settings.dispatch_secret in the database (local: supabase/seed.sql)
PUSH_DISPATCH_SECRET=local-dev-dispatch-secret
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=

# Optional
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=TextNext <no-reply@example.com>
# GOOGLE_BOOKS_API_KEY=
# CALIL_APP_KEY=
